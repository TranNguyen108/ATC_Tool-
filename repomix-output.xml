    "[id*='borlabs'] button",
    "[class*='borlabs'] button",
    # OneTrust
    "#onetrust-accept-btn-handler",
    ".onetrust-accept-btn-handler",
    # CookieBot
    "#CybotCookiebotDialogBodyButtonAccept",
    # Quantcast / Didomi
    "[data-gdpr-expression='acceptAll']",
    "#didomi-notice-agree-button",
